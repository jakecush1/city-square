{
  "name": "city-square",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A rainy-night Three.js street. Pick a door: the tavern opens Gilded Minstrels, the apartment opens the Bedroom Studio.",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "dev:tavern": "npm --prefix gilded-minstrels run dev -- --port 5174 --strictPort",
    "dev:studio": "npm --prefix bedroom-studio run dev -- --port 5175 --strictPort",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "vite build",
    "preview": "vite preview --port 5173"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.4"
  }
}
